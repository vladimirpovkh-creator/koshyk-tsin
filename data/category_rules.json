{
  "version": 6,
  "rules": [
    {
      "group": "Алкоголь і альтернативи",
      "label": "Безалкогольне пиво та вино",
      "pattern": "(?:пиво|вино|ігрист|шампан|просек|prosecco).*(?:б/а|безалког|0[.,]0?\\s*%)|(?:б/а|безалког).*(?:пиво|вино|ігрист|шампан)|глінтвейн.*(?:безалког|б/а)|(?:безалког|б/а).*глінтвейн"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Ігристі вина та шампанське",
      "pattern": "вино\\s+ігр|ігрист|шампан|просек|prosecco|креман|cr[eé]mant|(?:^|\\s)cava(?:\\s|$)",
      "exclude": "шоколад|цукерк|батончик|печив|тістеч|торт|десерт|аромат|смаком"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Пиво",
      "pattern": "пиво(?:\\s|$|[,.])|(?:^|\\s)(?:beer|ipa)(?:\\s|$|[,])",
      "exclude": "пивн[іи].*(?:снек|ковбас|дріждж)"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Вино",
      "pattern": "вино(?:\\s|$|[,.])|(?:^|\\s)wine(?:\\s|$)|шардоне|каберне|піно нуар|мерло|рислінг|shiraz|chablis|burgundy|глінтвейн|шпетлез|spatlese",
      "exclude": "оцет|соус|цукерк|шоколад|желе"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Сидр та слабоалкогольні напої",
      "pattern": "сидр|слабоалког|алкопоп|hard seltzer"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Горілка",
      "pattern": "горілк|(?:^|\\s)(?:водка|vodka)(?:\\s|$)"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Віскі та бурбон",
      "pattern": "віскі|whisk|бурбон|bourbon",
      "exclude": "цукерк|шоколад|тістеч|торт|аромат|корм|котів|собак|whiskas"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Коньяк та бренді",
      "pattern": "коньяк|бренді|cognac|brandy",
      "exclude": "цукерк|шоколад|тістеч|торт|аромат|смаком"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Ром",
      "pattern": "(?:^|\\s)ром(?:\\s|$|[,])|(?:^|\\s)rum(?:\\s|$|[,])|кашас|cachaça",
      "exclude": "цукерк|шоколад|тістеч|торт|аромат|смаком"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Джин",
      "pattern": "(?:^|\\s)джин(?:\\s|$|[,])|(?:^|\\s)gin(?:\\s|$|[,])",
      "exclude": "цукерк|шоколад"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Текіла",
      "pattern": "текіл|tequila",
      "exclude": "цукерк|шоколад"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Лікери, вермути та настоянки",
      "pattern": "лікер|лік[еє]р|настоянк|вермут|vermouth|бальзам.*(?:40%|алк|спирт)",
      "exclude": "цукерк|шоколад|тістеч|торт|аромат"
    },
    {
      "group": "Алкоголь і альтернативи",
      "label": "Інший алкоголь",
      "pattern": "алкогольн.*напій|спиртн.*напій"
    },
    {
      "group": "Товари для тварин",
      "label": "Корми та товари для тварин",
      "pattern": "корм|котяч|собач|кошенят|цуценят|наповнювач.*лоток|ласощі.*(?:кот|собак)"
    },
    {
      "group": "Дитячі товари",
      "label": "Дитяче харчування",
      "pattern": "дитяч.*(?:пюре|суміш|харч)|суміш.*дитяч|каша.*(?:немовлят|малюків)|пюре.*(?:gerber|гербер|індичк|телят|кролик)|(?:gerber|гербер).*пюре"
    },
    {
      "group": "Дитячі товари",
      "label": "Підгузки та дитяча гігієна",
      "pattern": "підгуз|пелюшк|серветк.*дитяч"
    },
    {
      "group": "Побут і гігієна",
      "label": "Посуд і кухонне приладдя",
      "pattern": "сковород|сотейник|каструл|кришка.*сковород|кухонн.*ніж|лопатка.*кухон|дошка.*обробн|салатник|тарілк|піал|бульйонниц|ємніст.*зберіган|банка.*(?:склян|кришк)|миска.*салатн|(?:^|\\s)ніж(?:\\s|$)"
    },
    {
      "group": "Побут і гігієна",
      "label": "Побутові дрібниці та батарейки",
      "pattern": "батарейк|швабр|набір.*прибиран|запаск.*валик|термосумк|ролик.*ворс|валик.*одяг"
    },
    {
      "group": "Побут і гігієна",
      "label": "Домашній текстиль",
      "pattern": "ковдр|плед|покривал|постільн.*білизн|простирадл|підковдр"
    },
    {
      "group": "Побут і гігієна",
      "label": "Пральні засоби",
      "pattern": "пральн|порошок.*пран|капсул.*пран|кондиціонер.*білизн|відбілювач|гель.*пран|ополіскувач.*(?:білизн|одяг)|плямовивідник|пом.якшувач.*білизн|кондиціонер.*(?:lenor|silan|ленор|силан)|пом.якшувач.*тканин|диск.*пран"
    },
    {
      "group": "Побут і гігієна",
      "label": "Засоби для прибирання",
      "pattern": "засіб.*(?:миття|чищення|видалення жиру)|посудомийн|миюч|очищувач|cleaner|гель.*посуд|губк|унітаз|засіб.*мийний|засіб.*чистяч|освіжувач повітря|аромадифузор|змінний.*аерозоль|аромадифузатор|засіб універсальн.*(?:frosch|для|чист)|гель.*чищенн|санвуз"
    },
    {
      "group": "Побут і гігієна",
      "label": "Особиста гігієна та косметика",
      "pattern": "шампун|мило|зубн|дезодорант|гель.*душ|прокладк|бритв|крем.*(?:обличч|рук|тіл)|лосьйон|ватні диски|лак.*волос|тампон|гель.*голін|піна.*голін|ополіскувач.*ротов|ополіскувач.*порожнин|маска.*волос|бальзам-ополіскувач|антиперспірант|вазелін косметич"
    },
    {
      "group": "Побут і гігієна",
      "label": "Паперові та побутові товари",
      "pattern": "рушник|папір туалет|серветк|пакет|фольг|контейнер|сміттєв|плівка харч|рукав.*запік|туалетн.*папір|етикетк|ролик.*для.*ворс",
      "exclude": "кондиціонер"
    },
    {
      "group": "Готова їжа",
      "label": "Готові страви та салати",
      "pattern": "олів.?є|салат(?:\\s|$|[,.])|зрази|готов[іиа].*страв|плов|суп(?:\\s|$)|борщ(?:\\s|$)|булгур.*м.яс|рагу|картоплян.*пюре|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|(?:м.ясо|ялович|свин|кур|качк).*тушкован|(?:ребр|м.ясо).*томлен|(?:^|\\s)курка\\s+гриль(?:\\s|$)|курча(?:та)?\\s+гриль",
      "exclude": "салат (?:айсберг|романо|латук|листов)|салат.*(?:насінн|соус|приправа)|печив|цукерк|вафл|хліб|багет|булоч|соус|сосиск|котлет.*бургер|пучок-свіжачок|бебі мікс|не митий|сендвічн.*хліб"
    },
    {
      "group": "Ковбаси та м’ясні вироби",
      "label": "М’ясні напівфабрикати та маринади",
      "pattern": "шашлик|котлет|стр[иі]пс|стрипс|ковбаски.*(?:грил|запік)|маринован.*(?:кур|м.яс|свин)|(?:куряч|курин|крила кур|крило кур|гомілка кур|гомілка|свин|м.ясн).*(?:в маринаді|маринован)|стейк.*маринад|кебаб.*(?:ялов|свин|кур)|(?:ялов|свин|кур).*кебаб"
    },
    {
      "group": "Хліб та випічка",
      "label": "Булочки, круасани та випічка",
      "pattern": "булоч|круасан|пиріг|пиріж|слойк|сочник|випічк|бублик|пончик|чіабат|багел|(?:^|\\s)тарт(?:\\s|$)"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Печиво та вафлі",
      "pattern": "печив|вафл|пряник|крекер|сухар.*солод|горіш(?:ок|ки|ки\\b|ечки)(?:\\s|$)|печен[ьн]я|вафельн.*кошик"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Торти та тістечка",
      "pattern": "торт|тістеч|чізкейк|десерт"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Шоколад та шоколадні батончики",
      "pattern": "шоколад|батончик.*(?:шокол|росен|roshen|kitkat|snickers|twix)|цукерк.*шоколад"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Цукерки та мармелад",
      "pattern": "цукерк|мармелад|зефір|пастил|іриск|карамел|(?:^|\\s)ірис(?:\\s|$)|мочі"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Морозиво",
      "pattern": "морозив|пломбір|ескімо"
    },
    {
      "group": "Бакалія",
      "label": "Готові сніданки, мюслі та гранола",
      "pattern": "готов[іиа].*снідан|сніданок сух|гранол|мюслі|пластівц.*(?:кукурудз|шоколад|мед)"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Горіхові пасти, креми та халва",
      "pattern": "(?:паста|крем).*(?:арахіс|горіх|фісташ|мигдал|фундук)|nutella|нутелл|халв"
    },
    {
      "group": "Хліб та випічка",
      "label": "Млинці, панкейки та хачапурі",
      "pattern": "млинц|млинець|панкейк|хачапур"
    },
    {
      "group": "Овочі та фрукти",
      "label": "Овочі та зелень",
      "pattern": "цибул|картоп|моркв|капуст|огір|помідор|томат(?!н.*соус)|(?:^|\\s)перець(?:\\s|$)|буряк|кабач|баклаж|гриб|редис|салат (?:айсберг|романо|латук|листов)|кріп|петруш|брокол|шпинат|авокадо|часник|порей|салат.*(?:бебі мікс|пучок-свіжачок|не митий)",
      "exclude": "соус|кетчуп|приправа|чипс|сухар|маринад|консерв|корм"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Горіхи, насіння та сухофрукти",
      "pattern": "горіх|арахіс|насінн|фісташ|мигдал|родзинк|кураг|сухофрукт|чорнослив|манго.*сушен|фундук",
      "exclude": "горіш(?:ок|ки|ечк).*(?:згущ|крем|начинк)|печив|вафл|тістеч|торт|цукерк|шоколад|батончик|десерт|напій.*(?:мигдал|соєв)|гранол|хлібц|борошн|паста.*какао|халв"
    },
    {
      "group": "Овочі та фрукти",
      "label": "Фрукти та ягоди",
      "pattern": "яблук|банан|апельсин|мандарин|лимон|груш|виноград|полуниц|малин|лохин|кавун|диня|ананас|манго|ківі|персик|слив|грейпфрут|черешн|нектарин",
      "exclude": "сік|нектар|цукерк|желе|йогурт|варенн|джем|печив|шоколад|корм|чай|сушен|сухофрукт|тістеч|торт|булоч|круасан|пиріг|пиріж|десерт"
    },
    {
      "group": "Риба та морепродукти",
      "label": "Рибні консерви та пресерви",
      "pattern": "пресерв|консерв.*(?:риб|тунц|тунец|тунець|лосос|оселед|сардин|скумбр)|(?:тунц|тунец|тунець|сардин|шпрот).*(?:олії|соусі|власному соку|з\\/б)"
    },
    {
      "group": "Риба та морепродукти",
      "label": "Морепродукти",
      "pattern": "кревет|кальмар|міді|восьминіг|устриц|краб|морепродукт"
    },
    {
      "group": "Риба та морепродукти",
      "label": "Риба свіжа та заморожена",
      "pattern": "лосос|сьомг|оселед|скумбр|тунц|тунец|тунець|рибн|риба|форел|хек|тріск|пангасіус|судак|короп|окунь|сібас|дорадо|тіляп|тиляп",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|суп|корм|консерв|паштет|соус|снек"
    },
    {
      "group": "Бакалія",
      "label": "Спеції та приправи",
      "pattern": "приправ|спеці[їя]|перець.*(?:мелен|чорн|горош)|паприк|кориц|ванілін|орегано|базилік|куркум|суміш перц"
    },
    {
      "group": "Бакалія",
      "label": "Соуси, кетчупи та майонези",
      "pattern": "соус|кетчуп|майонез|гірчиц|маринад|аджик|песто|дресинг|хумус"
    },
    {
      "group": "Заморожені продукти",
      "label": "Пельмені, вареники та напівфабрикати",
      "pattern": "пельмен|вареник|нагетс|заморожен.*(?:піца|млинець|млинці)|котлет.*заморож|млинці.*начинк|сирники.*заморож|млинці.*заморож"
    },
    {
      "group": "Ковбаси та м’ясні вироби",
      "label": "Ковбаси, сосиски та сардельки",
      "pattern": "ковбас(?!ки.*(?:грил|запік))|сосиск|сардельк|салям|фует|шпикач"
    },
    {
      "group": "Ковбаси та м’ясні вироби",
      "label": "Шинка, бекон та м’ясні делікатеси",
      "pattern": "шинка|бекон|буженин|пастрам|балик|грудинк.*копчен|рулет.*(?:куряч|м.ясн)|копчен.*(?:свин|кур|індич)|хамон|варено-копчен.*(?:кур|індич)|(?:крил|гомілк).*варено-копчен"
    },
    {
      "group": "Бакалія",
      "label": "Макарони та локшина",
      "pattern": "макарон|мак[.,\\s]*ви[рp]|спагеті|вермішел|локшин|паста.*(?:спірал|пера|бантик)|равіолі"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Фарш і субпродукти",
      "pattern": "фарш|печінк|серце кур|серця кур|потрух|субпродукт|нирк.*(?:свин|ялов|кур)|легені ялов|вим.я ялов|серце ялов|серця ялов|жир-сирець|нирк|язик.*(?:ялов|свин)"
    },
    {
      "group": "Хліб та випічка",
      "label": "Хліб та лаваш",
      "pattern": "хліб|батон|багет|лаваш|тостов|сухарики хлібн|хлібц"
    },
    {
      "group": "Заморожені продукти",
      "label": "Заморожене м’ясо та птиця",
      "pattern": "(?:куряч|курчат|курин|індич|качк|свинин|свиняч|ялович|теляч|м.ясо).{0,100}заморож|заморож.{0,100}(?:куряч|курчат|індич|свиняч|ялович)",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|корм"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Свіжа птиця",
      "pattern": "куряч|курчат|курка|курин|індич|індик|перепіл|філе кур|стегно кур|гомілк|крила кур|крило кур|качин|качк",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|(?:^|\\s)суп(?:\\s|$)|котлет|корм|консерв|паштет|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|локшин|макарон|зі смаком|із смаком|смаком|чипс|снек|пюре|gerber|гербер|етикетк|тушкован|копчен|гриль|заморож|crispy|strips"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Свіжа свинина",
      "pattern": "свинин|свиняч|свинний|оший|корейк|підчерев|ребра свин|стейк свин",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|(?:^|\\s)суп(?:\\s|$)|котлет|корм|консерв|паштет|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|локшин|макарон|зі смаком|із смаком|смаком|чипс|снек"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Свіжа яловичина та телятина",
      "pattern": "ялович|теляти|теляч|стейк ялов",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|(?:^|\\s)суп(?:\\s|$)|котлет|корм|консерв|паштет|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|локшин|макарон|зі смаком|із смаком|смаком|чипс|снек|кебаб|томлен|тушкован|субпродукт|легені|серце|вим.я|заморож|рисом.*овоч"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Свіжа баранина та ягнятина",
      "pattern": "баранин|бараняч|ягнятин|ягняч",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|(?:^|\\s)суп(?:\\s|$)|котлет|корм|консерв|паштет|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|локшин|макарон|зі смаком|із смаком|смаком|чипс|снек"
    },
    {
      "group": "Свіже м’ясо та птиця",
      "label": "Свіже м’ясо (інше)",
      "pattern": "м.ясо|м’ясо|мʼясо|кролик|кроляч|козлят|козяч",
      "exclude": "пиріг|пиріж|булоч|слойк|круасан|піца|салат|(?:^|\\s)суп(?:\\s|$)|котлет|корм|консерв|паштет|бургер|сендвіч|сендвич|сандвіч|шаурм|хот.?дог|локшин|макарон|зі смаком|із смаком|смаком|чипс|снек|тушкован|копчен|заморож|гриль"
    },
    {
      "group": "Молочні продукти",
      "label": "Яйця",
      "pattern": "яйц|яєчн",
      "exclude": "макарон|локшин|крем|соус"
    },
    {
      "group": "Молочні продукти",
      "label": "Кисломолочний сир",
      "pattern": "сир.*кисломолоч|творог|кисломолочн.*сир"
    },
    {
      "group": "Молочні продукти",
      "label": "Сирки та сиркові десерти",
      "pattern": "сирок.*глазур|сирк.*десерт|сирков.*десерт"
    },
    {
      "group": "Молочні продукти",
      "label": "Тверді, м’які та плавлені сири",
      "pattern": "сир(?:\\s|$|[-«])|сиру(?:\\s|$)|моцарел|бринз|пармезан|фет[а-и]|сулугун|чедер|рікот|маскарпоне|продукт сирн",
      "exclude": "сироп|сирн.*(?:соус|сухар|печиво)|булоч|пиріг|пиріж|круасан|слойк|піца|тістеч|торт|десерт|попкорн|смаком|ароматом|сухар|снек|чипс|попкорн|сирок.*глазур"
    },
    {
      "group": "Молочні продукти",
      "label": "Йогурти, кефір і сметана",
      "pattern": "кефір|йогурт|сметан|ряжанк|закваск|айран",
      "exclude": "булоч|пиріг|пиріж|печив|вафл|тістеч|торт|десерт|соус|корм"
    },
    {
      "group": "Молочні продукти",
      "label": "Вершкове масло",
      "pattern": "масло.*(?:вершк|солодковерш|селянськ)|(?:вершк|солодковерш|селянськ).*масло|(?:^|\\s)масло\\s+.{0,65}(?:82\\s*%|72[.,]5\\s*%)"
    },
    {
      "group": "Бакалія",
      "label": "Маргарин і спреди",
      "pattern": "маргарин|спред.*(?:вершк|рослин)"
    },
    {
      "group": "Молочні продукти",
      "label": "Молоко, вершки та рослинні напої",
      "pattern": "молоко|молочн.*напій|вершк|(?:напій|молоко).*(?:соєв|вівсян|мигдал|кокос)|напій.*(?:мигдалев|соєв|вівсян|кокосов)",
      "exclude": "горіш(?:ок|ки|ечк)|печив|вафл|тістеч|торт|десерт|цукерк|шоколад|батончик|пиріг|пиріж|булоч|круасан|млинц|млинець|кава|капучино|лате|суп|соус|корм|карамел|чипс|снек|маргарин|каша|готов.*снідан|смаком"
    },
    {
      "group": "Бакалія",
      "label": "Крупи, бобові та пластівці",
      "pattern": "(?:^|\\s)рис(?:\\s|$)|гречк|круп|булгур|кускус|пластівц|вівсян|квасол|сочевиц|манк|перловк|горох"
    },
    {
      "group": "Бакалія",
      "label": "Олія, оцет і жири",
      "pattern": "олія|оцет|оливкова.*олія|соняшников.*олія"
    },
    {
      "group": "Бакалія",
      "label": "Борошно, цукор та сіль",
      "pattern": "борошн|цукор|замінник цукр|(?:^|\\s)сіл(?:ь|\\s|$)|дріжджі|борошн.*(?:мигдал|фісташ)"
    },
    {
      "group": "Бакалія",
      "label": "Консерви, паштети та оливки",
      "pattern": "консерв|паштет|оливк|маслин|кукурудз.*(?:бан|консерв)|горошок.*(?:бан|консерв)"
    },
    {
      "group": "Бакалія",
      "label": "Джем, варення, мед та сиропи",
      "pattern": "джем|варенн|мед(?:\\s|$)|сироп"
    },
    {
      "group": "Солодощі та снеки",
      "label": "Чипси та снеки",
      "pattern": "чипс|снек|попкорн|сухарик|соломк.*солон"
    },
    {
      "group": "Напої",
      "label": "Какао та гарячий шоколад",
      "pattern": "какао-порошок|какао.*напій|гарячий шоколад"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Кава",
      "pattern": "кава(?:\\s|$|[,.])|кавов|coffee|еспресо|капучино",
      "exclude": "кавов.*(?:цукерк|торт|печив)"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Чай",
      "pattern": "чай(?:\\s|$|[,.])|чайний|tea(?:\\s|$)|матча"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Соки та нектари",
      "pattern": "(?:^|\\s)сік(?:\\s|$)|нектар|соков.*напій"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Енергетичні напої",
      "pattern": "енергетик|енергетичн.*напій|напій.*енергетич|energy drink"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Вода",
      "pattern": "вода(?:\\s|$|[,.])|води(?:\\s|$)|мінерал.*вода|джерельна"
    },
    {
      "group": "Безалкогольні напої",
      "label": "Лимонади та газовані напої",
      "pattern": "лимонад|газован.*напій|(?:^|\\s)кола(?:\\s|$)|tonic|тонік|напій"
    },
    {
      "group": "Інші товари",
      "label": "Інші товари",
      "pattern": ".+"
    }
  ]
}
